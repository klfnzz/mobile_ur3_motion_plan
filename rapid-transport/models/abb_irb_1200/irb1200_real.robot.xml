<?xml version="1.0" encoding="utf-8"?>
<Robot name="irb1200">
  
  <!-- Include the robots -->
  <Robot file="irb1200_5_90_lowspeed.dae">
    <diffuseColor>0.8 0.8 0.8</diffuseColor>
    <ambientcolor>0.6 0.6 0.6</ambientcolor>
  </Robot>


  <kinbody>
    <body name='suction_cup_holder' type="dynamic">
      <geom type="trimesh" modifiable="true">
        <diffuseColor> 0.69019608  0.76862745  0.87058824</diffuseColor>
        <render>meshes/cup/IRB-connection-1.3-cup_zmp_rs_mm.STL 0.001</render>
        <collision>meshes/cup/IRB-connection-1.3-cup_zmp_rs_mm.STL 0.001</collision>
      </geom>
      <offsetfrom>link_6</offsetfrom>
      <rotationaxis>1 0 0 180</rotationaxis>
      <translation>-0.003 0.04 0.092</translation>  
    </body>
    <joint name="joint_suction_cup_holder" type="hinge" enable="false">
      <body>link_6</body>
      <body>suction_cup_holder</body>
      <limits>0 0</limits>
    </joint>

    <body name="suction_head" type="dynamic">
      <geom type="trimesh" modifiable="true">
        <diffuseColor> 0.43921569  0.50196078  0.56470588 </diffuseColor>
        <render>meshes/cup/cup_2_mm.STL 0.001</render>
        <collision>meshes/cup/cup_2_mm.STL 0.001</collision>
      </geom>
      <offsetfrom>suction_cup_holder</offsetfrom>
      <rotationaxis>0 0 1 90</rotationaxis>
      <translation>0.0605 0.026 0.011 </translation>
    </body>
    <joint name="joint_suction_head" type="hinge" enable="false">
      <body>suction_cup_holder</body>
      <body>suction_head</body>
      <limits>0 0</limits>
    </joint>

    <body name="skirt" type="dynamic">
      <geom type="trimesh" modifiable="true">
        <diffuseColor> 0.43921569  0.50196078  0.56470588 </diffuseColor>
        <render>meshes/cup/cup_mm.STL 0.001</render>
        <collision>meshes/cup/cup_mm.STL 0.001</collision>
      </geom>
      <offsetfrom>suction_head</offsetfrom>
      <!-- <rotationaxis>0 1 0 180</rotationaxis> -->
      <translation>-0.014 -0.024 -0.014</translation>
    </body>
     <joint name="joint_skirt" type="hinge" enable="false">
      <body>suction_head</body>
      <body>skirt</body>
      <limits>0 0</limits>
    </joint>
   
  </kinbody>

  <!-- Define the manipulator -->
  <manipulator name="denso_ft_sensor">
    <base>base_link</base>
    <effector>suction_cup_holder</effector>
    <rotationaxis>0 1 0 90</rotationaxis>
    <rotationaxis>1 0 0 -90</rotationaxis>
    <translation>0.003 0.04 0.092</translation>
  </manipulator>

  <!-- Define the manipulator -->
  <manipulator name="denso_suction_cup">
    <base>base_link</base>
    <effector>suction_head</effector>
    <rotationaxis>1 0 0 90</rotationaxis>
    <rotationaxis>0 1 0 -180</rotationaxis>
    <translation>0.014 0.0 0.014 </translation>
  </manipulator>

  <!-- A slightly longer manipulator -->
  <manipulator name="denso_suction_cup2">  
    <base>base_link</base>
    <effector>skirt</effector>
    <rotationaxis>1 0 0 90</rotationaxis>
    <rotationaxis>0 1 0 -180</rotationaxis>
    <translation>0.027 0.0 0.027 </translation>
  </manipulator>
</Robot>
