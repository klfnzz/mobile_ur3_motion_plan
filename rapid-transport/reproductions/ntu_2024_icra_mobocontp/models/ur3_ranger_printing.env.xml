<?xml version="1.0" encoding="utf-8"?>
<environment>
  <camtrans>1.60 -2.30 1.55</camtrans>
  <camrotationaxis>0.707 0.000 0.707 135</camrotationaxis>
  <camfocal>2.0</camfocal>

  <!-- Mobile manipulator used for the reproduction: Ranger-style planar base + UR3 arm. -->
  <robot name="ur3">
    <robot file="../../../models/ur3/ur3.robot.xml"/>
    <jointvalues>
      3.1415926536 -1.5707963268 1.5707963268 -1.5707963268 -1.5707963268 0.0
    </jointvalues>
  </robot>

  <!-- A low work surface carrying the continuous "printing" task. -->
  <kinbody name="printing_surface">
    <translation>0 0 0</translation>
    <body name="surface" type="static">
      <Geom type="box">
        <translation>0.85 0.00 0.57</translation>
        <extents>0.82 0.38 0.015</extents>
        <diffusecolor>0.82 0.86 0.88</diffusecolor>
      </Geom>
    </body>
  </kinbody>

  <!-- Static obstacle: the DP planner excludes nearby base grid cells. -->
  <kinbody name="base_obstacle">
    <translation>0 0 0</translation>
    <body name="obstacle" type="static">
      <Geom type="box">
        <translation>0.75 -0.43 0.18</translation>
        <extents>0.18 0.08 0.18</extents>
        <diffusecolor>0.95 0.48 0.28</diffusecolor>
      </Geom>
    </body>
  </kinbody>
</environment>
